# Environment Configuration
# Copy this file to .env and fill in your values

# Model configuration (used as global fallback when not set in .yaml)
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxx

# GitLab MCP (optional; required for GitLab commit/MR URLs in code-review)
# GITLAB_API_URL=https://gitlab.example.com/api/v4
# GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxx

# Outlook MCP (optional; required for the outlook-mail playbook)
# One-time device-code login, then keep the cache outside the npx package directory:
#   npx -y @softeria/ms-365-mcp-server --login
# Paths must be absolute; they are passed through to the MCP process as-is.
# MS365_MCP_TOKEN_CACHE_PATH=/absolute/path/.config/ms365-mcp/.token-cache.json
# MS365_MCP_SELECTED_ACCOUNT_PATH=/absolute/path/.config/ms365-mcp/.selected-account.json

# OpenSandbox (optional; required for harness.open_sandbox.OpenSandbox)
# OPEN_SANDBOX_API_KEY=your-api-key
# OPEN_SANDBOX_DOMAIN=localhost:8080
