# Environment Configuration
# Copy this file to .env and fill in your values

# Provider env vars for name-only model entries that use pydantic-ai infer_model
# (e.g. openai:… / anthropic:… / google:… without model_provider on PlaybookSpec).
# Custom OpenAI-compatible endpoints belong in PlaybookSpec model_providers (or a Model capability).
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-xxx

# GitLab MCP (optional; skipped at agent build if unset — GitHub review still works)
# GITLAB_API_URL=https://gitlab.example.com/api/v4
# GITLAB_PERSONAL_ACCESS_TOKEN=glpat-xxx

# Outlook MCP (optional; required for the outlook-mail PlaybookSpec)
# One-time device-code login, then keep the cache outside the npx package directory:
#   npx -y @softeria/ms-365-mcp-server --login
# Paths must be absolute; they are passed through to the MCP process as-is.
# MS365_MCP_TOKEN_CACHE_PATH=/absolute/path/.config/ms365-mcp/.token-cache.json
# MS365_MCP_SELECTED_ACCOUNT_PATH=/absolute/path/.config/ms365-mcp/.selected-account.json
